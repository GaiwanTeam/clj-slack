{:paths ["src" "resources"]
 :deps
 {org.clojure/clojure {:mvn/version "1.12.5"}

  ;; Data formats
  metosin/jsonista      {:mvn/version "1.0.0"}
  lambdaisland/uri      {:mvn/version "1.19.155"}
  com.cnuernber/charred {:mvn/version "1.038"}

  ;; Time
  clojure.java-time/clojure.java-time {:mvn/version "1.4.3"}

  ;; Http/WS
  hato/hato                         {:mvn/version "1.0.0"}
  org.java-websocket/Java-WebSocket {:mvn/version "1.6.0"}

  ;; Logging
  io.pedestal/pedestal.log {:mvn/version "0.8.1"}
  com.lambdaisland/glogi   {:mvn/version "1.3.169"}

  org.slf4j/jul-to-slf4j         {:mvn/version "2.0.18"}
  org.slf4j/jcl-over-slf4j       {:mvn/version "2.0.18"}
  org.slf4j/log4j-over-slf4j     {:exclusions [org.slf4j/slf4j-nop], :mvn/version "2.0.18"}
  ch.qos.logback/logback-classic {:exclusions [org.slf4j/slf4j-api org.slf4j/slf4j-nop] :mvn/version "1.5.32"}}

 :aliases
 {:dev  {:extra-paths ["dev"]
         :extra-deps  {com.lambdaisland/classpath  {:mvn/version "0.6.58"}
                       io.github.nextjournal/clerk {:mvn/version "0.18.1158"}
                       djblue/portal               {:mvn/version "0.64.1"}}}
  :test {:extra-paths ["test"]
         :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}}}

  :garden {:extra-deps {garden/garden {:mvn/version "1.3.10"}}}

  :run/backfill {:exec-fn co.gaiwan.slack.backfill/backfill}}}
